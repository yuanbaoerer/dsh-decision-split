{
  "name": "dsh-decision-split",
  "version": "0.1.5",
  "description": "决策分屏：agent 输出含「决策摘要」段的方案时，主窗口显示摘要与决策编辑框，右侧详情栏独立展示完整 markdown，决策一键发回 agent。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanbaoerer/dsh-decision-split.git"
  },
  "bugs": {
    "url": "https://github.com/yuanbaoerer/dsh-decision-split/issues"
  },
  "homepage": "https://github.com/yuanbaoerer/dsh-decision-split",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web-ui",
    "decision",
    "markdown"
  ],
  "scripts": {
    "pack:check": "npm pack --dry-run"
  }
}
